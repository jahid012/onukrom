includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    # Read model casts from the body of casts(): our models declare them there,
    # so without this every datetime/array cast is seen as a raw string column.
    parseModelCastsMethod: true
